# =====================================================================
# PAVIDEZ DOCS — variáveis de ambiente
# Copie para .env (na raiz do projeto) e preencha. Nunca versione o .env.
# Caminhos relativos são resolvidos a partir da raiz do projeto.
# =====================================================================

NODE_ENV=development

# --- Endereços -------------------------------------------------------
# URL pública do painel/portal (usada nos links enviados aos solicitantes)
APP_URL=http://localhost:3000
# Porta da API (NestJS)
API_PORT=4000
# Usado pelo Next.js para repassar /api/* para a API
API_INTERNAL_URL=http://localhost:4000
# Quantos proxies existem na frente da API (para registrar o IP real e limitar tentativas por IP).
# 1 = somente o Next.js (padrão). Next.js atrás de Nginx/Caddy/Render = 2.
# A porta da API não deve ficar exposta publicamente.
TRUST_PROXY_HOPS=1

# --- Banco de dados (PostgreSQL / Supabase) --------------------------
# Local:    postgresql://postgres:postgres@localhost:5432/pavidez_docs
# Supabase: Project Settings > Database > Connection string (URI) — use a conexão "Session pooler"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pavidez_docs
# true para Supabase / bancos gerenciados
DATABASE_SSL=false

# --- Segurança (gere valores aleatórios: openssl rand -base64 48) ------
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
TOKEN_ENCRYPTION_KEY=troque-por-outro-valor-aleatorio-com-32-caracteres-ou-mais
FILE_URL_SECRET=troque-por-mais-um-valor-aleatorio-com-32-caracteres-ou-mais
# Duração da sessão do painel (horas)
SESSION_HOURS=12
# true em produção (HTTPS)
COOKIE_SECURE=false

# --- Autenticação dos usuários internos -------------------------------
# local    = senhas com bcrypt na tabela users
# supabase = credenciais validadas no Supabase Auth (papéis continuam na tabela users)
AUTH_PROVIDER=local

# --- Armazenamento de arquivos (sempre privado) -----------------------
# local    = disco do servidor (LOCAL_STORAGE_DIR)
# supabase = Supabase Storage (bucket privado, criado automaticamente se não existir)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# --- Supabase (necessário se AUTH_PROVIDER ou STORAGE_DRIVER = supabase) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# chave service_role: somente no servidor, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pavidez-docs

# --- Uploads e links --------------------------------------------------
MAX_UPLOAD_MB=20
MAX_FILES_PER_UPLOAD=10
# Validade padrão do link exclusivo (dias). Nunca expira antes do fim do dia do prazo.
LINK_DEFAULT_EXPIRATION_DAYS=30
# Validade das URLs temporárias para visualizar/baixar arquivos (segundos)
SIGNED_URL_TTL_SECONDS=300

# --- Retenção (LGPD) --------------------------------------------------
# Dias após FINALIZADO/CANCELADO para remover os ARQUIVOS (0 = não remove).
RETENTION_DAYS=0
# true = executa a remoção automaticamente uma vez por dia
RETENTION_AUTO_PURGE=false

# --- E-mail -----------------------------------------------------------
# log  = grava os e-mails como .eml em EMAIL_LOG_DIR (desenvolvimento)
# smtp = envia via SMTP (Google Workspace, Microsoft 365, Amazon SES, Resend, Brevo...)
EMAIL_DRIVER=log
EMAIL_LOG_DIR=./storage/emails
EMAIL_FROM="PAVIDEZ DOCS <no-reply@pavidez.com.br>"
SMTP_HOST=
SMTP_PORT=587
# true para porta 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Destinatário padrão do PDF final e das notificações internas
DEFAULT_NOTIFY_EMAIL=rh@pavidez.com.br
# Avisar o solicitante por e-mail quando um documento for rejeitado (se ele tiver e-mail)
NOTIFY_APPLICANT_EMAILS=true

# --- Empresa ----------------------------------------------------------
COMPANY_NAME=PAVIDEZ ENGENHARIA
COMPANY_CNPJ=01.744.153/0001-06
COMPANY_LOGO_PATH=./apps/api/assets/logo-pavidez.png

# --- Administrador inicial (criado por "npm run db:seed") --------------
ADMIN_EMAIL=admin@pavidez.com.br
ADMIN_NAME=Administrador
# mínimo 8 caracteres (ignorado com AUTH_PROVIDER=supabase: crie o usuário no Supabase Auth)
ADMIN_PASSWORD=TroqueEstaSenha123

# --- OCR / IA (opcional, fase futura) ----------------------------------
# none = desativado. Veja apps/api/src/analysis/analysis.service.ts
DOCUMENT_ANALYZER=none
